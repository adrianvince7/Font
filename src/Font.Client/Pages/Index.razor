@page "/"

<PageTitle>Font - Support for Recovery</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Height="200px">
                <MudText Typo="Typo.h5" Class="mb-4">Find Meetings</MudText>
                <MudText>Connect with local AA groups and find meetings near you.</MudText>
                <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Href="/meetings">Find Meetings</MudButton>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Height="200px">
                <MudText Typo="Typo.h5" Class="mb-4">Chat Support</MudText>
                <MudText>Connect with others in recovery through our secure chat system.</MudText>
                <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Secondary" Href="/chat">Join Chat</MudButton>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4" Height="200px">
                <MudText Typo="Typo.h5" Class="mb-4">Track Progress</MudText>
                <MudText>Monitor your recovery journey and celebrate milestones.</MudText>
                <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Href="/profile">View Progress</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-8" />

    <MudText Typo="Typo.h4" Class="mb-4">About Font</MudText>
    <MudText>
        Font is a supportive community for those in recovery. Our name, symbolized by 'AA', represents strength 
        and resilience in the journey of recovery from alcohol and substance abuse. We provide tools and 
        connections to help you maintain sobriety and build a stronger support network.
    </MudText>

    <MudAlert Severity="Severity.Info" Class="mt-8">
        If you need immediate assistance, please call our 24/7 helpline or reach out to a local AA group.
    </MudAlert>
</MudContainer> 